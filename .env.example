# BLUSHCART V9 environment template — never commit real secrets.
BLUSHCART_SECRET=replace-with-a-long-random-secret
BLUSHCART_HOST=0.0.0.0
PORT=5000
BLUSHCART_HTTPS=1
PUBLIC_BASE_URL=https://your-domain.example

# Put SQLite on a persistent disk/volume in production.
BLUSHCART_DB_PATH=/data/blushcart.db
BLUSHCART_BACKUP_DIR=/data/backups

# Razorpay (start with TEST keys, switch to LIVE only after full testing)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=use-a-separate-webhook-secret
